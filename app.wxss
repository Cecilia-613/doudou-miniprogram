/**
 * 《兜兜》全局样式 —— 适老化设计规范
 * 1px = 2rpx（设计稿 375px）
 * 字号变量会被每个页面根节点的 style 覆盖（三档：标准 / 大 / 超大）
 */
page {
  /* 色板（暖色底，避免冷蓝） */
  --bg: #FFF6EA;
  --card: #FFFFFF;
  --ink: #1F1B16;
  --ink-2: #5C5348;
  --brand: #E8622A;
  --brand-2: #C1440E;
  --danger: #D93025;
  --danger-bg: #FDECEA;
  --warn: #E8A317;
  --warn-bg: #FFF6E0;
  --safe: #1E8E3E;
  --safe-bg: #E9F5EC;
  --ask: #7A6247;
  --ask-bg: #F3EDE4;
  --line: #E5D9C7;

  /* 字号：基准 Body 22px */
  --fs-h1: 64rpx;
  --fs-h2: 52rpx;
  --fs-title: 48rpx;
  --fs-body: 44rpx;
  --fs-cap: 36rpx;
  --ic-s: 48rpx;         /* 图标三档，随字号档一起放大（见 utils/theme.js） */
  --ic-m: 60rpx;
  --ic-l: 72rpx;

  /* 触控 */
  --tap: 128rpx;         /* 最小 64px */
  --gap: 32rpx;          /* 最小间距 16px */

  background: var(--bg);
  color: var(--ink);
  font-size: var(--fs-body);
  line-height: 1.7;
  font-family: -apple-system, "PingFang SC", "Noto Sans SC", "Microsoft YaHei", "Helvetica Neue", sans-serif;
  font-variant-numeric: tabular-nums;   /* 数字等宽：分数、时间、电话竖着也对齐 */
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, scroll-view {
  box-sizing: border-box;
}

/* ---------- 布局 ---------- */
.page {
  min-height: 100vh;
  padding-bottom: 220rpx; /* 给底部固定条留位 */
  padding-left: 32rpx;
  padding-right: 32rpx;
}
.sec { margin-top: 40rpx; }
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.col { display: flex; flex-direction: column; }

/* ---------- 卡片 ---------- */
.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 32rpx;
  border: 2rpx solid var(--line);
}
.card-flat { border: none; }

/* ---------- 文字 ---------- */
.h1 { font-size: var(--fs-h1); font-weight: 700; line-height: 1.4; }
.h2 { font-size: var(--fs-h2); font-weight: 700; line-height: 1.4; }
.title { font-size: var(--fs-title); font-weight: 600; line-height: 1.5; }
.body { font-size: var(--fs-body); font-weight: 500; line-height: 1.7; }
.cap { font-size: var(--fs-cap); line-height: 1.6; color: var(--ink-2); }
.cap-ink { font-size: var(--fs-cap); line-height: 1.6; color: var(--ink); }

/* ---------- 按钮（最小 64×64，主按钮全圆） ---------- */
.btn {
  min-height: var(--tap);
  min-width: var(--tap);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 600;
  padding: 16rpx 40rpx;
  margin: 0;
  border: none;
  line-height: 1.25;      /* 按钮是单行标签，不吃全局 1.7 行高，上下才不会偏 */
  text-align: center;
}
.btn::after { border: none; }
.btn-primary { background: var(--brand); color: #fff; }
.btn-primary.btn-hover { background: var(--brand-2); }
.btn-primary[disabled] { background: #C9C2B6; color: #fff; }
.btn-outline { background: var(--card); color: var(--ink); border: 4rpx solid var(--line); }
.btn-danger { background: var(--danger); color: #fff; }
.btn-ghost { background: rgba(255,255,255,.16); color: #fff; }

.btn-lg {
  min-height: 176rpx; /* 88px 行的结果页按钮 */
  padding: 16rpx 44rpx;
}

/* ---------- 风险三档快捷色（颜色 + 图标 + 文字 三重编码） ---------- */
.lv-danger { color: var(--danger); }
.lv-warn { color: var(--warn); }
.lv-safe { color: var(--safe); }
.lv-ask { color: var(--ask); }
.bg-danger { background: var(--danger-bg); }
.bg-warn { background: var(--warn-bg); }
.bg-safe { background: var(--safe-bg); }
.bg-ask { background: var(--ask-bg); }

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 64rpx;
  padding: 8rpx 24rpx;
  line-height: 1.25;
  border-radius: 999rpx;
  font-size: var(--fs-cap);
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

/* ---------- 底部固定条 ---------- */
.bottom-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: rgba(255,255,255,.96);
  border-top: 2rpx solid var(--line);
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  z-index: 20;
  gap: 24rpx;
}

/* ---------- 编号圆圈：现在做三件事 ---------- */
.step-dot {
  width: calc(var(--fs-title) * 1.5); height: calc(var(--fs-title) * 1.5);
  border-radius: 999rpx;
  background: var(--brand);
  color: #fff;
  font-size: calc(var(--fs-title) * .8);
  line-height: 1;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* ---------- 骨架屏 / 加载动效 ---------- */
.skeleton-line {
  height: 44rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #EFE6D6 25%, #F8F1E4 37%, #EFE6D6 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
  margin-bottom: 24rpx;
}
@keyframes shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

.spin {
  width: 96rpx; height: 96rpx;
  border-radius: 999rpx;
  border: 10rpx solid var(--line);
  border-top-color: var(--brand);
  animation: rotate 1s linear infinite;
}
@keyframes rotate { to { transform: rotate(360deg); } }

.divider {
  height: 2rpx;
  background: var(--line);
  margin: 32rpx 0;
}

/* ================= 对齐工具类（新增） ================= */

/* 图标盒：emoji 在不同手机上宽高、基线都不一样，
   统一放进「固定宽高 + 居中」的盒子里，文字才不会跟着它上下跳。 */
.ico {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 1.3em;
  height: 1.3em;
  line-height: 1;
  text-align: center;
  font-size: var(--ic-m);
}
.ico-s { font-size: var(--ic-s); }
.ico-m { font-size: var(--ic-m); }
.ico-l { font-size: var(--ic-l); }

/* 长段中文：两端对齐，右边缘整齐（按字距分散，不会出现英文那种大空格） */
.para {
  display: block;
  text-align: justify;
  text-justify: inter-ideograph;
  word-break: break-all;
}

/* 一行内「左图标 + 文字」：图标盒和文字垂直居中 */
.line { display: flex; align-items: center; gap: 16rpx; }
.grow { flex: 1; min-width: 0; }      /* flex 子项想换行而不是撑爆，必须有 min-width:0 */
.flex1 { flex: 1; }
.nowrap { white-space: nowrap; }
.one-line { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ================= 以前每页各写一份、且只有首页有的共用样式 ================= */
.card-hover { background: var(--warn-bg); }

.bar-btn {
  flex: 1;
  min-height: 176rpx;
  padding: 12rpx 16rpx;
  font-size: var(--fs-title);
  display: flex;
  flex-direction: column;    /* 图标在上、字在下：字号放到最大也不会挤出按钮 */
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  text-align: center;
}
.bar-btn-2 {
  background: var(--card);
  color: var(--ink);
  border: 4rpx solid var(--brand);
}
.bar-btn .btn-label { line-height: 1.25; }

.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(31, 27, 22, .5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 50;
}
.sheet {
  width: 686rpx;
  background: var(--bg);
  border-radius: 32rpx;
  padding: 40rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  max-height: 82vh;
  overflow-y: auto;          /* 超大档内容变多时在面板里滚，不再溢出面板外 */
  display: flex;
  flex-direction: column;
}
.center-col { align-items: center; text-align: center; }

.help-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 176rpx;
  background: var(--card);
  border-radius: 20rpx;
  padding: 16rpx 28rpx;
  margin-top: 24rpx;
  border: 4rpx solid var(--brand);
}
.help-main { flex: 1; min-width: 0; }

/* 圆圈里的数字 / 字母：line-height:1 + flex 居中，字在圆里上下左右都正 */
.dot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 999rpx;
  line-height: 1;
  font-weight: 700;
  text-align: center;
}
