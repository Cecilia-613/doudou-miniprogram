.cm-page {
  padding-bottom: 260rpx;
}

.cm-head {
  padding-top: calc(env(safe-area-inset-top) + 24rpx);
  margin-bottom: 24rpx;
}

/* 三个页签：最小点击区 64×64，字跟着全局字号走 */
.cm-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.cm-tab {
  flex: 1;
  min-width: 0;
  min-height: 128rpx;
  padding: 8rpx 8rpx;
  line-height: 1.25;
  text-align: center;
  border-radius: 999rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink-2);
}
.cm-tab.on {
  background: var(--brand);
  border-color: var(--brand);
  color: #fff;
}

/* 工单 */
.tk {
  background: var(--card);
  border-radius: 20rpx;
  border: 2rpx solid var(--line);
  border-left: 12rpx solid var(--brand);
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}
.tk-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.tk-id { font-size: var(--fs-cap); line-height: 1.4; color: var(--ink-2); }
.tk-tag {
  font-size: var(--fs-cap);
  font-weight: 600;
  padding: 4rpx 16rpx;
  line-height: 1.4;
  border-radius: 999rpx;
  background: var(--ask-bg);
}
.tk-mid {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.tk-type { flex: 1; min-width: 0; font-size: var(--fs-title); font-weight: 700; line-height: 1.4; }
.tk-state {
  font-size: var(--fs-cap);
  font-weight: 600;
  padding: 6rpx 20rpx;
  line-height: 1.4;
  border-radius: 999rpx;
  background: var(--safe-bg);
  color: var(--safe);
  white-space: nowrap;
}
.tk-state.todo { background: var(--danger-bg); color: var(--danger); }
.tk-bot {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 本周高发 */
.top-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 2rpx solid var(--line);
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}
.top-rank {
  width: 72rpx; height: 72rpx;
  background: var(--brand);
  color: #fff;
  font-size: 40rpx;
}
.top-count {
  font-size: var(--fs-h2);
  font-weight: 700;
  color: var(--danger);
  flex-shrink: 0;
}

/* 话术包 */
.talk-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 2rpx solid var(--line);
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}
.talk-no {
  width: calc(var(--fs-body) * 1.5); height: calc(var(--fs-body) * 1.5);   /* 对着第一行 */
  background: var(--warn-bg);
  color: var(--brand-2);
  font-size: calc(var(--fs-body) * .75);
}
.talk-text { flex: 1; min-width: 0; font-size: var(--fs-body); line-height: 1.5; }
.talk-copy {
  flex-shrink: 0;
  font-size: var(--fs-cap);
  font-weight: 600;
  color: var(--brand-2);
  padding: 6rpx 16rpx;
  line-height: 1.4;
  border: 2rpx solid var(--brand);
  border-radius: 999rpx;
}

.cm-all { margin-top: 8rpx; }
.cm-foot { display: block; margin-top: 24rpx; }
