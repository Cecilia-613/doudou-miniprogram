<view class="page s-{{scale}} l-{{lang}}" style="{{vars}}">

  <!-- 顶部：问候 + 方言 / 字号
       注意：右上角是微信自带的胶囊按钮（关闭 / 更多），必须给它让路，
       所以这一整块按量出来的胶囊宽度留白，两个小按钮也挪到了下面一行靠左。 -->
  <view class="top" style="padding-right:{{capsuleSafe}}rpx">
    <view class="col">
      <text class="h2">{{greet}}，{{profile.name}}</text>
      <text class="cap">今天要不要测一测？</text>
    </view>
    <view class="chip-row">
      <view class="chip" bindtap="toggleDialect" hover-class="chip-hover">
        <text class="cap-ink">{{lang === 'cn' ? txt.dialectBtn : txt.mandarinBtn}}</text>
      </view>
      <view class="chip" bindtap="openSetting" hover-class="chip-hover">
        <text class="cap-ink">字</text>
      </view>
    </view>
  </view>

  <!-- 主语音按钮：距底黄金位 -->
  <view class="mic-area">
    <mic-button
      label="{{txt.holdToTalk}}"
      pressed-tip="{{txt.listening}}"
      bind:recordingstart="onRecordStart"
      bind:recorded="onRecorded"
      bind:error="onRecordError" />
    <view class="mic-sub cap" bindtap="openQuick">说不清？点这里挑一句 ›</view>
  </view>

  <!-- 两个 96px 高卡片：图标、标题、副标题三行各自固定高度并居中，
       这样副标题长短不一样，两张卡的标题也还是齐平的 -->
  <view class="grid2">
    <view class="big-card" bindtap="goCapture" hover-class="card-hover">
      <text class="ico ico-l">📷</text>
      <text class="c-title">{{txt.takePhoto}}</text>
      <text class="c-sub">短信・纸条・包装盒</text>
    </view>
    <view class="big-card" bindtap="goQuiz" hover-class="card-hover">
      <text class="ico ico-l">📝</text>
      <text class="c-title">{{txt.weeklyQuiz}}</text>
      <text class="c-sub">五道题，五分钟</text>
    </view>
  </view>

  <!-- 最近问过 -->
  <view class="sec">
    <view class="row-between">
      <text class="title">{{txt.recentAsk}}</text>
      <text wx:if="{{history.length}}" class="cap see-all" bindtap="goHistory">全部 ›</text>
    </view>
    <view wx:if="{{!history.length}}" class="card empty-wrap">
      <text class="cap">还没有问过。按住上面的圆按钮，慢慢讲就好。</text>
    </view>
    <view wx:for="{{history}}" wx:key="id"
          class="hist-item"
          hover-class="card-hover"
          bindtap="goHistory">
      <text class="ico ico-s">{{item.icon}}</text>
      <text class="hist-text one-line">{{item.short}}</text>
      <text class="hist-time cap nowrap">{{item.ago}}</text>
    </view>
  </view>

  <!-- 底部固定条：图标和字分成两个块，用 flex 居中对齐，
       字号放到超大档也不会各跑一边、不会折行 -->
  <view class="bottom-bar">
    <view class="btn btn-primary bar-btn" bindtap="openQuick" hover-class="btn-hover">
      <text class="ico ico-m">🎤</text>
      <text class="btn-label">{{txt.holdToTalk}}</text>
    </view>
    <view class="btn bar-btn bar-btn-2" bindtap="openHelp" hover-class="btn-hover">
      <text class="ico ico-m">🆘</text>
      <text class="btn-label">{{txt.askHelp}}</text>
    </view>
  </view>

  <!-- 骨架浮层：必须有动效，老人以为卡住就会退出 -->
  <view wx:if="{{loading}}" class="mask">
    <view class="sheet center-col">
      <view class="spin"></view>
      <text class="title" style="margin-top:32rpx">{{loadingTip}}</text>
      <view class="skeleton-line" style="margin-top:40rpx;width:80%"></view>
      <view class="skeleton-line" style="width:60%"></view>
    </view>
  </view>

  <!-- 快捷问法面板（零打字） -->
  <view wx:if="{{panel === 'pick'}}" class="mask" bindtap="closePick">
    <view class="sheet" catchtap="noop">
      <text class="h2">没听清，您要问的是哪个？</text>
      <text class="cap">（点一下就出结果，一个字也不用打）</text>
      <scroll-view scroll-y class="pick-list">
        <view wx:for="{{quickAsks}}" wx:key="text"
              class="pick-item"
              hover-class="card-hover"
              data-text="{{item.text}}"
              bindtap="onPick">
          <text class="ico ico-s">{{item.icon}}</text>
          <text class="pick-text">{{item.text}}</text>
          <text class="pick-arrow ico ico-m">›</text>
        </view>
      </scroll-view>
      <view class="btn btn-outline" style="margin-top:24rpx" bindtap="closePick">{{txt.cancel}}</view>
    </view>
  </view>

  <!-- 求人帮忙 -->
  <view wx:if="{{panel === 'help'}}" class="mask" bindtap="closePanel">
    <view class="sheet" catchtap="noop">
      <view class="line"><text class="ico ico-l">🆘</text><text class="h2 grow">我马上叫人来</text></view>
      <text class="body" style="margin-top:20rpx">选一个人，我替您喊他来一趟。</text>

      <view class="help-item" bindtap="callHelper" data-phone="{{profile.kid.phone}}">
        <text class="ico ico-l">👩</text>
        <view class="col help-main">
          <text class="title">{{profile.kid.name}}</text>
          <text class="cap">{{profile.kid.phone}}（女儿）</text>
        </view>
        <text class="ico ico-m">📞</text>
      </view>
      <view class="help-item" bindtap="callHelper" data-phone="{{profile.helper.phone}}">
        <text class="ico ico-l">🧑‍💼</text>
        <view class="col help-main">
          <text class="title">{{profile.helper.name}}</text>
          <text class="cap">{{profile.helper.phone}}（社区）</text>
        </view>
        <text class="ico ico-m">📞</text>
      </view>

      <view class="btn btn-outline" style="margin-top:28rpx" bindtap="closePanel">{{txt.cancel}}</view>
    </view>
  </view>

  <!-- 设置面板 -->
  <view wx:if="{{panel === 'setting'}}" class="mask" bindtap="closePanel">
    <view class="sheet" catchtap="noop">
      <text class="h2">{{txt.fontTitle}}</text>
      <view class="row" style="margin-top:24rpx;gap:16rpx">
        <view class="font-opt {{scale==='std'?'on':''}}" data-v="std" bindtap="setFont">标准</view>
        <view class="font-opt {{scale==='large'?'on':''}}" data-v="large" bindtap="setFont">大</view>
        <view class="font-opt {{scale==='xl'?'on':''}}" data-v="xl" bindtap="setFont">超大</view>
      </view>

      <view class="divider"></view>

      <view class="row-between switch-row" bindtap="toggleDialect">
        <view class="col grow">
          <text class="title">讲上海闲话</text>
          <text class="cap">只换屏幕上的字，说话还是普通话</text>
        </view>
        <text class="switch {{lang==='sh'?'on':''}}">{{lang==='sh'?'开':'关'}}</text>
      </view>

      <view class="row-between switch-row" bindtap="toggleVoice">
        <view class="col grow">
          <text class="title">自动读给您听</text>
          <text class="cap">进入结果就会读一遍</text>
        </view>
        <text class="switch {{voiceOn?'on':''}}">{{voiceOn?'开':'关'}}</text>
      </view>

      <view class="divider"></view>

      <view class="row" style="gap:16rpx">
        <view class="end-card" bindtap="goFamily" hover-class="card-hover">
          <text class="ico ico-m">👩</text>
          <text class="e-title">{{txt.kidReport}}</text>
          <text class="e-cap">{{txt.kidReportTip}}</text>
        </view>
        <view class="end-card" bindtap="goCommunity" hover-class="card-hover">
          <text class="ico ico-m">🧑‍💼</text>
          <text class="e-title">{{txt.communityEnd}}</text>
          <text class="e-cap">{{txt.communityEndTip}}</text>
        </view>
      </view>

      <view class="row-between hist-link" bindtap="goHistory">
        <text class="title">历史记录</text>
        <text class="title">›</text>
      </view>

      <view class="btn btn-primary" style="margin-top:28rpx" bindtap="closePanel">{{txt.iKnow}}</view>
    </view>
  </view>

</view>
