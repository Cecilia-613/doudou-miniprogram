.quiz-page { padding-bottom: 80rpx; }

.prog { margin-bottom: 16rpx; min-height: 96rpx; }
.quit {
  text-decoration: underline;
  min-height: 96rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
}
.prog-bar { height: 20rpx; border-radius: 999rpx; background: var(--line); overflow: hidden; }
.prog-fill { height: 100%; background: var(--brand); border-radius: 999rpx; transition: width .3s ease; }

.scenario {
  margin-top: 32rpx;
  background: var(--card);
  border-radius: 20rpx;
  padding: 32rpx;
  border: 2rpx solid var(--line);
}
.scenario .body { white-space: pre-line; }

.q-title { display: block; margin: 32rpx 0 24rpx; }

/* 选项：A/B/C/D 圆圈和选项第一行文字同高、顶对齐；文字再多行圆圈也不漂 */
.opt {
  min-height: 192rpx;
  border-radius: 20rpx;
  background: var(--card);
  border: 4rpx solid var(--line);
  padding: 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}
.opt-right { border-color: var(--safe); background: var(--safe-bg); }
.opt-wrong { border-color: var(--danger); background: var(--danger-bg); }
.opt-mark {
  width: calc(var(--fs-title) * 1.5);
  height: calc(var(--fs-title) * 1.5);
  font-size: calc(var(--fs-title) * .8);
  background: var(--bg);
  color: var(--ink-2);
}
.opt-text { flex: 1; min-width: 0; font-size: var(--fs-title); font-weight: 500; line-height: 1.5; }
.opt-tick { height: calc(var(--fs-title) * 1.5); }

.explain { margin-top: 32rpx; border-radius: 20rpx; padding: 32rpx; }
.ex-right { background: var(--safe-bg); border: 4rpx solid var(--safe); }
.ex-wrong { background: var(--warn-bg); border: 4rpx solid var(--warn); }
.ex-body { display: block; margin-top: 12rpx; }
.ex-head .title { line-height: 1.4; }
